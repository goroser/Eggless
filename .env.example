# Google: server key, restricted to Places API (New)
GOOGLE_PLACES_API_KEY=

# Google: browser key, restricted by HTTP referrer to the site's domain
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=

# LLM used for menu extraction
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5

# Postgres (set automatically by `vercel install neon`)
DATABASE_URL=

# Signs the short-lived tokens passed from /api/search to /api/menu
MENU_TOKEN_SECRET=

# Vercel Cron sends this as a bearer token to /api/cron/refresh
CRON_SECRET=

# Optional: rendering fallback for client-side-rendered café sites
FIRECRAWL_API_KEY=
